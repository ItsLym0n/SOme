<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home -->
        <ScrollView
            android:id="@+id/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/header_home"
                    style="@style/Union.Header">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/Union.HeaderTitle"
                        android:layout_marginTop="48dp"
                        android:background="?attr/selectableItemBackground" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Union.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="14dp">

                            <LinearLayout
                                android:id="@+id/stat_today"
                                style="@style/Union.Stat">

                                <TextView
                                    style="@style/Union.StatLabel"
                                    app:drawableStartCompat="@drawable/stat_today"
                                    android:text="@string/stat_today" />

                                <TextView
                                    android:id="@+id/stat_today_value"
                                    style="@style/Union.StatValue" />
                            </LinearLayout>

                            <View style="@style/Union.StatDivider" />

                            <LinearLayout style="@style/Union.Stat">

                                <TextView
                                    style="@style/Union.StatLabel"
                                    app:drawableStartCompat="@drawable/stat_checked"
                                    android:text="@string/stat_checked_in" />

                                <TextView
                                    android:id="@+id/stat_checked_value"
                                    style="@style/Union.StatValue" />
                            </LinearLayout>

                            <View style="@style/Union.StatDivider" />

                            <LinearLayout style="@style/Union.Stat">

                                <TextView
                                    style="@style/Union.StatLabel"
                                    app:drawableStartCompat="@drawable/stat_next"
                                    android:text="@string/stat_next" />

                                <TextView
                                    android:id="@+id/stat_next_value"
                                    style="@style/Union.StatValue" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <LinearLayout
                        android:id="@+id/tile_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Union.SectionTitle"
                        android:text="@string/section_reminders" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/reminder_card"
                        style="@style/Union.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/next_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@color/text_body"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/setup_warning"
                                android:layout_width="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:drawablePadding="8dp"
                                android:gravity="center"
                                android:textColor="@color/union_orange"
                                android:textSize="14sp"
                                android:visibility="gone"
                                app:drawableStartCompat="@drawable/ic_warning"
                                app:drawableTint="@color/union_orange" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/Union.SectionTitle"
                        android:text="@string/section_today" />

                    <TextView
                        android:id="@+id/today_empty"
                        style="@style/Union.EmptyCard"
                        android:text="@string/today_empty" />

                    <LinearLayout
                        android:id="@+id/today_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Weekly schedule -->
        <ScrollView
            android:id="@+id/page_schedule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/header_schedule"
                    style="@style/Union.Header">

                    <TextView
                        style="@style/Union.HeaderTitle"
                        android:layout_marginTop="32dp"
                        android:text="@string/section_week" />

                    <TextView
                        android:id="@+id/week_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#D6E4F3"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/add_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/add_class" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/import_button"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/import_export" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/week_empty"
                        style="@style/Union.EmptyCard"
                        android:layout_marginTop="16dp"
                        android:text="@string/empty" />

                    <LinearLayout
                        android:id="@+id/week_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Profile & setup -->
        <ScrollView
            android:id="@+id/page_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/header_profile"
                    style="@style/Union.Header">

                    <TextView
                        android:id="@+id/profile_name"
                        style="@style/Union.HeaderTitle"
                        android:layout_marginTop="32dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/app_name"
                        android:textColor="#D6E4F3"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <TextView
                        style="@style/Union.SectionTitle"
                        android:text="@string/section_setup" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Union.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/setup_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/Union.SectionTitle"
                        android:text="@string/section_more" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Union.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/more_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:text="@string/disclaimer"
                        android:textColor="@color/text_label"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom tab bar, UNION style: icon only, blue line over the active tab. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tab_home"
            style="@style/Union.Tab">

            <View style="@style/Union.TabIndicator" />

            <ImageView
                style="@style/Union.TabIcon"
                android:contentDescription="@string/tab_home"
                android:src="@drawable/ic_home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_schedule"
            style="@style/Union.Tab">

            <View style="@style/Union.TabIndicator" />

            <ImageView
                style="@style/Union.TabIcon"
                android:contentDescription="@string/tab_schedule"
                android:src="@drawable/ic_event" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_profile"
            style="@style/Union.Tab">

            <View style="@style/Union.TabIndicator" />

            <ImageView
                style="@style/Union.TabIcon"
                android:contentDescription="@string/tab_profile"
                android:src="@drawable/ic_person" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
